# Copia questo file in .env.local (prove locali) e imposta gli stessi valori
# nelle variabili d'ambiente di Vercel. NON inserire valori reali in questo file.
# Dove trovare ogni valore: vedi SETUP.md.

# ID client OAuth (finisce con .apps.googleusercontent.com). SETUP.md, passo 4.
GOOGLE_CLIENT_ID=

# Dominio ammesso, senza @. SETUP.md, passo 8.
ALLOWED_DOMAIN=

# Contenuto intero del file JSON della chiave dell'account di servizio. SETUP.md, passo 5.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID del foglio Google con le schede. SETUP.md, passo 7.
SHEET_ID=

# ID del Drive condiviso e delle tre cartelle (servono dal passo 2 in poi). SETUP.md, passo 6.
DRIVE_ID=
FOLDER_DA_APPROVARE_ID=
FOLDER_APPROVATE_ID=
FOLDER_SCARTATE_ID=

# Chiave segreta per firmare la sessione del sito (almeno 32 caratteri casuali). SETUP.md, passo 8.
# Se la cambi, tutti devono rifare l'accesso. Genera un valore con: openssl rand -base64 48
SESSION_SECRET=

# Segreto per la sincronizzazione notturna con OSM2CAI (almeno 32 caratteri casuali). SETUP.md, passo 8.
# Vercel lo invia da solo nella chiamata notturna; su un altro hosting lo mette chi pianifica la chiamata.
# Genera un valore con: openssl rand -base64 48
CRON_SECRET=
